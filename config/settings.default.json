{
    "_comment": "Default settings. Do not edit this file; the UI (or you) writes overrides to config/settings.json, which is deep-merged on top of this file. API keys belong in .env (see .env.example).",
    "llm": {
        "default_provider": "gemini",
        "default_models": {
            "writer": "gemini:gemini-3.1-pro-preview",
            "reflection": "gemini:gemini-3.1-pro-preview",
            "plotting": "gemini:gemini-3.1-pro-preview",
            "search": "gemini:gemini-3-flash-preview",
            "fast": "gemini:gemini-3-flash-preview",
            "revision": "gemini:gemini-3.1-pro-preview"
        },
        "providers": {
            "gemini": {
                "type": "gemini",
                "label": "Google Gemini (API key or Vertex AI)",
                "supports_vision": true,
                "supports_pdf": true
            },
            "openai": {
                "type": "openai_compatible",
                "label": "OpenAI",
                "base_url": "https://api.openai.com/v1",
                "api_key_env": "OPENAI_API_KEY",
                "supports_vision": true,
                "drop_temperature": true,
                "system_role": "developer",
                "timeout": 900,
                "max_concurrency": null,
                "image_mode": "images_api"
            },
            "openrouter": {
                "type": "openai_compatible",
                "label": "OpenRouter",
                "base_url": "https://openrouter.ai/api/v1",
                "api_key_env": "OPENROUTER_API_KEY",
                "supports_vision": true,
                "timeout": 900,
                "max_concurrency": null,
                "extra_headers": {
                    "HTTP-Referer": "https://github.com/google-research/paper-orchestra",
                    "X-Title": "PaperOrchestra"
                },
                "image_mode": "chat_modalities"
            },
            "ollama": {
                "type": "ollama",
                "label": "Ollama (local, native API)",
                "base_url": "http://localhost:11434",
                "supports_vision": false,
                "num_ctx": 32768,
                "keep_alive": "30m",
                "think": null,
                "timeout": 3600,
                "max_concurrency": 1
            },
            "llamacpp": {
                "type": "openai_compatible",
                "label": "llama.cpp server (local)",
                "base_url": "http://localhost:8080/v1",
                "api_key": "sk-no-key-required",
                "supports_vision": false,
                "timeout": 3600,
                "max_concurrency": 1
            },
            "vllm": {
                "type": "openai_compatible",
                "label": "vLLM (OpenAI-compatible server)",
                "base_url": "http://localhost:8000/v1",
                "api_key_env": "VLLM_API_KEY",
                "api_key": "EMPTY",
                "supports_vision": false,
                "timeout": 3600,
                "max_concurrency": 8,
                "extra_body": {}
            },
            "lmstudio": {
                "type": "openai_compatible",
                "label": "LM Studio (local)",
                "base_url": "http://localhost:1234/v1",
                "api_key": "lm-studio",
                "supports_vision": false,
                "timeout": 3600,
                "max_concurrency": 1
            },
            "custom": {
                "type": "openai_compatible",
                "label": "Custom OpenAI-compatible endpoint",
                "base_url": "",
                "api_key_env": "CUSTOM_LLM_API_KEY",
                "supports_vision": false,
                "timeout": 1800,
                "max_concurrency": 4,
                "image_mode": "images_api"
            }
        }
    },
    "image": {
        "default_backend": "gemini:gemini-3-pro-image-preview",
        "comfyui": {
            "base_url": "http://127.0.0.1:8188",
            "workflow_path": "config/comfyui_workflows/sdxl_txt2img_api.json",
            "checkpoint": "sd_xl_base_1.0.safetensors",
            "steps": 30,
            "cfg": 6.5,
            "sampler": "dpmpp_2m",
            "scheduler": "karras",
            "negative_prompt": "blurry, low quality, watermark, signature, jpeg artifacts, distorted text, photo, photorealistic",
            "megapixels": 1.0,
            "condense_prompt": true,
            "max_prompt_words": 120,
            "timeout": 900
        },
        "mcp_servers": {
            "example-stdio": {
                "enabled": false,
                "transport": "stdio",
                "command": "npx",
                "args": ["-y", "your-image-mcp-server"],
                "env": {},
                "tool": "generate_image",
                "prompt_arg": "prompt",
                "extra_args": {},
                "timeout": 600
            },
            "example-http": {
                "enabled": false,
                "transport": "streamable_http",
                "url": "http://127.0.0.1:8000/mcp",
                "headers": {},
                "tool": "generate_image",
                "prompt_arg": "prompt",
                "extra_args": {"width": "{{WIDTH}}", "height": "{{HEIGHT}}"},
                "timeout": 600
            }
        },
        "http_apis": {
            "example-openai-images": {
                "enabled": false,
                "url": "https://api.openai.com/v1/images/generations",
                "method": "POST",
                "headers": {"Authorization": "Bearer ${OPENAI_API_KEY}"},
                "body": {"model": "gpt-image-1", "prompt": "{{PROMPT}}", "size": "{{OPENAI_SIZE}}", "n": 1},
                "response_path": "data.0.b64_json",
                "timeout": 600
            }
        }
    },
    "plotting": {
        "plot_engine": "matplotlib",
        "diagram_engine": "image",
        "code_timeout": 180,
        "dpi": 300,
        "remotion": {
            "project_dir": "tools/remotion",
            "width": 1920,
            "height": 1080,
            "fps": 30,
            "duration_frames": 150,
            "render_animation": false,
            "timeout": 600
        }
    },
    "literature": {
        "search_backend": "auto",
        "s2_min_interval_sec": 1.1,
        "paperbanana_dir": ""
    },
    "pipeline": {
        "max_reflections": 3,
        "plotting_max_critic_rounds": 3,
        "max_pipeline_retries": 3,
        "latex_timeout": 120
    },
    "ui": {
        "projects_dir": "projects",
        "language": "zh-TW"
    }
}
