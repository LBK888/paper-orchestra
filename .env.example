# PaperOrchestra keys. Fill in only what you use; you can also set them in the UI (Settings > Keys).
# Model names select the provider: gemini:..., openai:..., openrouter:..., ollama:..., llamacpp:..., vllm:..., lmstudio:..., custom:...

# Google Gemini: either an API key, or Vertex AI project + location
GEMINI_API_KEY=
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=

# OpenAI / OpenRouter / other OpenAI-compatible endpoints
OPENAI_API_KEY=
OPENROUTER_API_KEY=
VLLM_API_KEY=
CUSTOM_LLM_API_KEY=

# Literature search (strongly recommended to avoid rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# Optional: PaperBanana checkout with few-shot figure references and style guides
PAPERBANANA_DIR=

# Optional: legacy Streamlit demo e-mail notification
SMTP_EMAIL=
SMTP_PASSWORD=
